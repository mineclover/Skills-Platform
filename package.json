{
  "name": "skills-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the Skills Catalog control plane and the Skills Manager delivery adapter.",
  "workspaces": [
    "apps/skills-catalog",
    "apps/catalog-ui",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "check": "npm run --workspaces --if-present check",
    "test": "npm run --workspaces --if-present test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
