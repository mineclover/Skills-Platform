{
  "version": 1,
  "hooks": {
    "post_tool_execution": [
      {
        "matcher": {
          "tools": [
            "*"
          ]
        },
        "command": "node .skills-platform/hooks/telemetry-hook.js --platform claude"
      }
    ],
    "stdio_event": [
      {
        "command": "node .skills-platform/hooks/telemetry-hook.js --platform claude --mode stdio"
      }
    ]
  }
}
